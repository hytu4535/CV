@page
@model CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<h3 class="mb-4">Thanh toán</h3>

<form method="post">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h5 class="mb-3">Thông tin giao hàng</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <input type="tel" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Địa chỉ</label>
                        <input type="text" class="form-control" placeholder="Số nhà, tên đường" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tỉnh / Thành phố</label>
                        <select class="form-select">
                            <option>TP. Hồ Chí Minh</option>
                            <option>Hà Nội</option>
                            <option>Đà Nẵng</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Quận / Huyện</label>
                        <input type="text" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú</label>
                        <textarea class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h5 class="mb-3">Phương thức thanh toán</h5>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="pay" id="cod" checked />
                    <label class="form-check-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="pay" id="bank" />
                    <label class="form-check-label" for="bank">Chuyển khoản ngân hàng</label>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="radio" name="pay" id="momo" />
                    <label class="form-check-label" for="momo">Ví MoMo</label>
                </div>

                <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
                    <span>Tổng cộng</span>
                    <span class="price">1.719.000 ₫</span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Đặt hàng</button>
                <a asp-page="/Cart" class="btn btn-link w-100 mt-2">← Quay lại giỏ hàng</a>
            </div>
        </div>
    </div>
</form>