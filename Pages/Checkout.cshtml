@page
@model CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
}

<h3 class="mb-4">Thanh toán</h3>

<form method="post" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h5 class="mb-3">Thông tin giao hàng</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.FullName" required />
                        <span class="text-danger small" asp-validation-for="Input.FullName"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" asp-for="Input.Phone" required />
                        <span class="text-danger small" asp-validation-for="Input.Phone"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" asp-for="Input.Email" required />
                        <span class="text-danger small" asp-validation-for="Input.Email"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Input.Address" required />
                        <span class="text-danger small" asp-validation-for="Input.Address"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="Input.Province" required>
                            <option value="">-- Chọn tỉnh / thành phố --</option>
                            <option>TP. Hồ Chí Minh</option>
                            <option>Hà Nội</option>
                            <option>Đà Nẵng</option>
                        </select>
                        <span class="text-danger small" asp-validation-for="Input.Province"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Quận / Huyện</label>
                        <input type="text" class="form-control" asp-for="Input.District" />
                        <span class="text-danger small" asp-validation-for="Input.District"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú</label>
                        <textarea class="form-control" asp-for="Input.Note" rows="3"></textarea>
                        <span class="text-danger small" asp-validation-for="Input.Note"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h5 class="mb-3">Phương thức thanh toán</h5>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" value="cod" asp-for="Input.PaymentMethod" />
                    <label class="form-check-label" for="Input_PaymentMethod">Thanh toán khi nhận hàng (COD)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" value="bank" asp-for="Input.PaymentMethod" />
                    <label class="form-check-label" for="Input_PaymentMethod">Chuyển khoản ngân hàng</label>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="radio" value="momo" asp-for="Input.PaymentMethod" />
                    <label class="form-check-label" for="Input_PaymentMethod">Ví MoMo</label>
                </div>

                <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
                    <span>Tổng cộng</span>
                    <span class="price">@Model.GrandTotal.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) ₫</span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Đặt hàng</button>
                <a asp-page="/Cart" class="btn btn-link w-100 mt-2">← Quay lại giỏ hàng</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}