<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyShop Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="d-flex">
    <!-- Sidebar -->
    <nav class="bg-dark sidebar offcanvas-sm offcanvas-start" tabindex="-1" id="adminSidebar">
        <div class="offcanvas-header p-4 pt-0">
            <h5 class="offcanvas-title text-white"><i class="bi bi-shop"></i> MyShop Admin</h5>
            <button type="button" class="btn-close text-white btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <nav class="nav flex-column">
                <a class="nav-link text-white @(ViewData["ActivePage"] == "Products" ? "active" : "")" asp-area="" asp-page="/Admin/Products/Index">
                    <i class="bi bi-box me-2"></i> Sản phẩm
                </a>
                <a class="nav-link text-white @(ViewData["ActivePage"] == "Orders" ? "active" : "")" asp-area="" asp-page="/Admin/Orders/Index">
                    <i class="bi bi-card-list me-2"></i> Đơn hàng
                </a>
                <a class="nav-link text-white @(ViewData["ActivePage"] == "Customers" ? "active" : "")" asp-area="" asp-page="/Admin/Customers/Index">
                    <i class="bi bi-people me-2"></i> Khách hàng
                </a>
                <hr class="my-1 bg-light" />
                <a class="nav-link text-white-50" asp-page="/Index">
                    <i class="bi bi-house-door me-2"></i> Xem website
                </a>
            </nav>
        </div>
    </nav>

    <!-- Page Content -->
    <div class="w-100">
        <!-- Topbar -->
        <header class="bg-white border-bottom shadow-sm">
            <div class="container-fluid px-4">
                <div class="d-flex justify-content-between align-items-center py-3">
                    <button class="btn btn-link p-0 text-muted d-lg-none" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <form class="d-none d-md-flex me-3" role="search">
                        <input class="form-control form-control-sm border-0 shadow-none" type="search" placeholder="Tìm kiếm..." aria-label="Search">
                    </form>
                    <div class="dropdown">
                        <button class="btn btn-link p-0 text-decoration-none dropdown-toggle" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell fs-4"></i>
                            <span class="badge bg-danger rounded-pill ms-1">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end mt-2 w-250 p-0" aria-labelledby="notificationsDropdown">
                            <li><a class="dropdown-item d-flex align-items-center" href="#"> <div class="me-3"> <i class="bi bi-check-circle fs-5 text-success"></i> </div> <div> Đơn hàng mới #1001 </div> <small class="text-muted">5 phút trước</small> </a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-center text-muted" href="#">Xem tất cả thông báo</a></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-link p-0 text-decoration-none dropdown-toggle" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://via.placeholder.com/32" class="rounded-circle me-2" alt=""> Admin
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end mt-2 w-100 p-0" aria-labelledby="profileDropdown">
                            <li><a class="dropdown-item" asp-page="/Admin/Login">Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="container-fluid px-4 py-3">
            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>