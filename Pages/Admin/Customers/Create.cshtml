@page
@model CreateModel
@{
    ViewData["Title"] = "Thêm khách hàng";
    ViewData["ActivePage"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="mb-1">Thêm khách hàng</h2><p class="text-muted mb-0">Nhập thông tin khách hàng mới.</p></div>
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

<form method="post" novalidate class="stat-card">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Họ tên <span class="text-danger">*</span></label>
                <input type="text" class="form-control" asp-for="Input.FullName" required />
                <span class="text-danger small" asp-validation-for="Input.FullName"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                <input type="email" class="form-control" asp-for="Input.Email" required />
                <span class="text-danger small" asp-validation-for="Input.Email"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                <input type="tel" class="form-control" asp-for="Input.Phone" required />
                <span class="text-danger small" asp-validation-for="Input.Phone"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input type="text" class="form-control" asp-for="Input.Address" />
                <span asp-validation-for="Input.Address" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top">
        <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-check-lg"></i> Lưu
        </button>
        <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}