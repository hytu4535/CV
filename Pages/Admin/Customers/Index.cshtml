@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý khách hàng";
    ViewData["ActivePage"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý khách hàng</h2>
        <p class="text-muted mb-0">Quản lý thông tin và lịch sử khách hàng.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-dark border px-3 py-2">@Model.Customers.Count khách hàng</span>
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm khách hàng</a>
    </div>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Msg"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tìm theo họ tên, email, SĐT, địa chỉ..." />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Đặt lại</a>
    </div>
</form>

@if (Model.Customers.Count == 0)
{
    <div class="stat-card text-center py-5"><i class="bi bi-people display-5 text-muted"></i><h5 class="mt-3">Không tìm thấy khách hàng nào</h5><p class="text-muted mb-0">Thử thay đổi từ khóa tìm kiếm.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th style="width: 60px;">Avatar</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>
                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 1rem;">
                                @c.FullName[0]
                            </div>
                        </td>
                        <td>@c.FullName</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td>@c.Address</td>
                        <td class="text-end">
                            <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này?');">
                                    <i class="bi bi-trash"></i> Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}