<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="@Model.status" asp-route-StartDate="@Model.StartDate" asp-route-EndDate="@Model.EndDate" asp-route-pageNumber="@(Model.PageNumber - 1)">« Trước</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">« Trước</span></li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="@Model.status" asp-route-StartDate="@Model.StartDate" asp-route-EndDate="@Model.EndDate" asp-route-pageNumber="@i">@i</a>
                </li>
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="@Model.status" asp-route-StartDate="@Model.StartDate" asp-route-EndDate="@Model.EndDate" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau »</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Sau »</span></li>
            }
        </ul>
    </nav>
}