@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    ViewData["ActivePage"] = "Orders";
}

<a asp-page="./Index" class="btn btn-outline-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Quay lại
</a>

<!-- Search and Filter -->
<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="input-group">
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tìm theo tên khách hàng hoặc mã đơn..." />
            <button class="btn btn-outline-secondary" type="submit">Tìm</button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" placeholder="Từ ngày" />
            <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" placeholder="Đến ngày" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-grid gap-2">
            <button class="btn btn-outline-secondary" type="submit">Lọc</button>
            <a asp-page="./Index" class="btn btn-outline-danger">Reset</a>
        </div>
    </div>
</form>

<!-- Status Tabs -->
<div class="mb-4">
    <nav>
        <div class="nav nav-tabs" id="orderStatusTab" role="tablist">
            <button class="nav-link @((string.IsNullOrEmpty(Model.status) || Model.status.ToLower() == "all" || Model.status.ToLower() == "tất cả") ? "active" : "")"
                    id="tab-all" data-bs-toggle="tab" data-bs-target="#tab-all-content" type="button" role="tab"
                    asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="all">
                Tất cả @Model.TotalOrders
            </button>
            <button class="nav-link @(Model.status.ToLower() == "pending" || Model.status.ToLower() == "chờ xử lý") ? "active" : "")"
                    id="tab-pending" data-bs-toggle="tab" data-bs-target="#tab-pending-content" type="button" role="tab"
                    asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="chờ xử lý">
                Chờ xử lý @Model.PendingCount
            </button>
            <button class="nav-link @(Model.status.ToLower() == "shipping" || Model.status.ToLower() == "đang giao") ? "active" : "")"
                    id="tab-shipping" data-bs-toggle="tab" data-bs-target="#tab-shipping-content" type="button" role="tab"
                    asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="đang giao">
                Đang giao @Model.ShippingCount
            </button>
            <button class="nav-link @(Model.status.ToLower() == "completed" || Model.status.ToLower() == "hoàn thành") ? "active" : "")"
                    id="tab-completed" data-bs-toggle="tab" data-bs-target="#tab-completed-content" type="button" role="tab"
                    asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="hoàn thành">
                Hoàn thành @Model.CompletedCount
            </button>
            <button class="nav-link @(Model.status.ToLower() == "cancelled" || Model.status.ToLower() == "đã hủy") ? "active" : "")"
                    id="tab-cancelled" data-bs-toggle="tab" data-bs-target="#tab-cancelled-content" type="button" role="tab"
                    asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-status="đã hủy">
                Đã hủy @Model.CancelledCount
            </button>
        </div>
    </nav>
    <div class="tab-content mt-3" id="orderStatusTabContent">
        <!-- All tab -->
        <div class="tab-pane fade @((string.IsNullOrEmpty(Model.status) || Model.status.ToLower() == "all" || Model.status.ToLower() == "tất cả") ? "show active" : "")" id="tab-all-content" role="tabpanel" aria-labelledby="tab-all">
            <div class="table-responsive">
                <table class="table table-admin">
                    <thead>
                        <tr>
                            <th>Mã DH</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Orders.Any())
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>@($"#DH{order.Id:D4}")</td>
                                    <td>@order.Customer.FullName</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@(order.TotalAmount.ToString("N0", new CultureInfo("vi-VN"))) ₫</td>
                                    <td>
                                        @{
                                            var badgeClass = order.Status switch
                                            {
                                                OrderStatus.Pending => "bg-warning text-dark",
                                                OrderStatus.Shipping => "bg-info text-white",
                                                OrderStatus.Completed => "bg-success text-white",
                                                OrderStatus.Cancelled => "bg-danger text-white",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">
                                            @order.StatusVietnamese
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="./Details" asp-route-id="@order.Id" class="text-sm text-muted">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có đơn hàng nào</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

