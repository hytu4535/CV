@page
@model IndexModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div class="stat-title">Doanh thu</div>
            <div class="stat-value">@Model.TotalRevenue.ToString("N0", new CultureInfo("vi-VN")) ₫</div>
            <div class="stat-trend text-success">
                <i class="bi bi-arrow-up"></i> +12% so với tháng trước
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-cart-check"></i>
            </div>
            <div class="stat-title">Số đơn hàng</div>
            <div class="stat-value">@Model.TotalOrders</div>
            <div class="stat-trend text-info">
                <i class="bi bi-arrow-up"></i> +8% so với tháng trước
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-title">Khách hàng</div>
            <div class="stat-value">@Model.TotalCustomers</div>
            <div class="stat-trend text-success">
                <i class="bi bi-arrow-up"></i> +5% so với tháng trước
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-box"></i>
            </div>
            <div class="stat-title">Sản phẩm</div>
            <div class="stat-value">@Model.TotalProducts</div>
            <div class="stat-trend text-warning">
                <i class="bi bi-arrow-up"></i> +3% so với tháng trước
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Doanh thu 6 tháng gần nhất</h5>
            </div>
            <div class="card-body p-0">
                <canvas id="revenueChart" height="200"></canvas>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Tỷ lệ trạng thái đơn hàng</h5>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <canvas id="statusChart" height="200"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">5 đơn hàng mới nhất</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-admin mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Khách hàng</th>
                                    <th>Ngày</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.LatestOrders)
                                {
                                    <tr>
                                        <td>#DH000@order.Id</td>
                                        <td>@order.CustomerName</td>
                                        <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">@order.Total.ToString("N0", new CultureInfo("vi-VN")) ₫</td>
                                        <td>
                                            <span class="badge badge-status @order.StatusBadgeClass">
                                                @order.StatusText
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/Orders/Details" asp-route-id="@order.Id" class="text-sm text-muted">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">5 sản phẩm bán chạy</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-admin mb-0">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá</th>
                            <th>Đã bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.TopProducts)
                        {
                            <tr>
                                <td>
                                    <img src="@product.ImageUrl" alt="@product.Name" class="img-thumbnail" style="width: 60px;">
                                </td>
                                <td>@product.Name</td>
                                <td>@product.Category</td>
                                <td class="text-end">@product.PriceText</td>
                                <td class="text-end">
                                    @{
                                        int sold = 0;
                                        foreach (var order in OrderData.All)
                                        {
                                            var item = order.Items.FirstOrDefault(i => i.Product.Id == product.Id);
                                            if (item != null) sold += item.Quantity;
                                        }
                                    }
                                    @sold
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Revenue Chart
            const revenueCtx = document.getElementById('revenueChart').getContext('2d');
            new Chart(revenueCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(Model.RevenueLabels)),
                    datasets: [{
                        label: 'Doanh thu (triệu ₫)',
                        data: @Html.Raw(JsonSerializer.Serialize(Model.RevenueValues.Select(v => v / 1000000.0))),
                        borderColor: 'var(--primary)',
                        backgroundColor: 'var(--primary)opacity-0.1',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '₫' + (context.parsed.y * 1000000).toLocaleString('vi-VN');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return '₫' + (value * 1000000).toLocaleString('vi-VN');
                                }
                            }
                        }
                    }
                }
            });

            // Status Chart
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(Model.StatusLabels)),
                    datasets: [{
                        data: @Html.Raw(JsonSerializer.Serialize(Model.StatusValues)),
                        backgroundColor: @Html.Raw(JsonSerializer.Serialize(
                            Model.StatusColors.Select(c =>
                                c == "warning" ? "#ffc107" :
                                c == "info" ? "#0dcaf0" :
                                c == "success" ? "#28a745" :
                                c == "danger" ? "#dc3545" :
                                "#6c757d"
                            ).ToArray()))
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                padding: 15
                            }
                        }
                    }
                }
            });
        });
    </script>
}