@page
@model CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
    var vn = new System.Globalization.CultureInfo("vi-VN");
}

<h3 class="mb-4">Giỏ hàng của bạn</h3>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="bg-white rounded-3 shadow-sm p-3 table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@item.Product.ImageUrl" class="cart-img" alt="" />
                                    <a asp-page="/Products/Detail" asp-route-id="@item.Product.Id"
                                       class="text-decoration-none">@item.Product.Name</a>
                                </div>
                            </td>
                            <td>@item.Product.PriceText</td>
                            <td><input type="number" class="form-control form-control-sm qty-input" value="@item.Quantity" min="1" /></td>
                            <td class="price">@item.TotalText</td>
                            <td><button class="btn btn-sm btn-outline-dark"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a asp-page="/Products/Index" class="btn btn-link mt-2">← Tiếp tục mua sắm</a>
    </div>

    <div class="col-lg-4">
        <div class="bg-white rounded-3 shadow-sm p-4">
            <h5 class="mb-3">Tóm tắt đơn hàng</h5>
            <div class="d-flex justify-content-between mb-2">
                <span>Tạm tính</span>
                <span>@Model.SubTotal.ToString("N0", vn) ₫</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Phí vận chuyển</span>
                <span>@(Model.Shipping == 0 ? "Miễn phí" : Model.Shipping.ToString("N0", vn) + " ₫")</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
                <span>Tổng cộng</span>
                <span class="price">@Model.GrandTotal.ToString("N0", vn) ₫</span>
            </div>
            <div class="input-group mb-3">
                <input type="text" class="form-control" placeholder="Mã giảm giá" />
                <button class="btn btn-outline-dark">Áp dụng</button>
            </div>
            <a asp-page="/Checkout" class="btn btn-primary w-100 btn-lg">Tiến hành thanh toán</a>
        </div>
    </div>
</div>