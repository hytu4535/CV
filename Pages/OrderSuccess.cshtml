@page "{id:int}"
@model ShopUI.Pages.OrderSuccessModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="auth-shell">
    <div class="auth-card text-center">
        <i class="bi bi-check-circle-fill text-success display-1"></i>
        <h2 class="mt-3">Đặt hàng thành công!</h2>
        <p class="text-muted">Cảm ơn bạn đã mua sắm tại MyShop. Đơn hàng #DH<Model.OrderId.ToString("D4")> đã được ghi nhận.</p>
        <div class="d-grid gap-2 mt-4">
            <a asp-page="/Orders/Details" asp-route-id="@Model.OrderId" class="btn btn-primary">Xem chi tiết đơn hàng</a>
            <a asp-page="/Index" class="btn btn-outline-secondary">Quay về trang chủ</a>
        </div>
    </div>
</div>