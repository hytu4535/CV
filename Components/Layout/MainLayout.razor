@inherits LayoutComponentBase

<div class="top-bar text-center py-1 small">
    Miễn phí vận chuyển cho đơn từ 500.000 ₫ <i class="bi bi-truck"></i>
</div>

<header class="site-header bg-white border-bottom sticky-top shadow-sm">
    <nav class="navbar navbar-expand-lg container py-3">
        <NavLink class="navbar-brand brand" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-bag-heart-fill"></i> MyShop
        </NavLink>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Trang chủ</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/products">Sản phẩm</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/products?category=Giày">Giày</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="/products?category=Áo">Áo</NavLink></li>
            </ul>
            <form class="d-flex me-3" action="/products" method="get">
                <input class="form-control form-control-sm" type="search" name="search" placeholder="Tìm sản phẩm..." />
                <button class="btn btn-sm btn-dark ms-1" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <AuthorizeView>
                <Authorized>
                    <span class="small text-muted me-2">Xin chào, @context.User.Identity?.Name</span>
                    <a class="btn btn-link btn-sm text-decoration-none me-2" href="/orders">Đơn hàng</a>
                    <a class="btn btn-outline-dark btn-sm me-3" href="/auth/logout">Đăng xuất</a>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-dark btn-sm me-3" href="/login">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeView>
            <NavLink class="btn btn-outline-dark btn-sm" href="/cart"><i class="bi bi-cart3"></i> Giỏ hàng</NavLink>
        </div>
    </nav>
</header>

<main class="container py-4">
    @Body
</main>

<footer class="site-footer mt-5 pt-5 pb-3">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4"><h5><i class="bi bi-bag-heart-fill"></i> MyShop</h5><p class="small">Thời trang và phụ kiện chất lượng, giá tốt mỗi ngày.</p></div>
            <div class="col-md-4"><h6>Liên kết</h6><ul class="list-unstyled small"><li><a href="/">Trang chủ</a></li><li><a href="/products">Sản phẩm</a></li><li><a href="/cart">Giỏ hàng</a></li><li><a href="/admin">Quản trị</a></li></ul></div>
            <div class="col-md-4"><h6>Liên hệ</h6><ul class="list-unstyled small"><li><i class="bi bi-telephone"></i> 0123 456 789</li><li><i class="bi bi-envelope"></i> hello@myshop.vn</li><li><i class="bi bi-geo-alt"></i> TP. Hồ Chí Minh</li></ul></div>
        </div>
        <hr class="border-secondary" />
        <div class="text-center small">© 2026 MyShop. All rights reserved.</div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi. <a href="." class="reload">Tải lại</a>
    <span class="dismiss">×</span>
</div>
