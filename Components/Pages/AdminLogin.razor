@page "/admin"
@layout AdminLoginLayout
@using Microsoft.AspNetCore.Components

<PageTitle>Admin Login - MyShop</PageTitle>
<div class="auth-page"><div class="auth-card bg-white rounded-3 shadow-sm p-4"><div class="text-center mb-4"><i class="bi bi-shield-lock auth-icon"></i><h2>Quản trị viên</h2><p class="text-muted">Đăng nhập khu vực quản trị</p></div>@if(!string.IsNullOrWhiteSpace(Error)){<div class="alert alert-danger">@Error</div>}<form method="post" action="/auth/admin-login"><div class="mb-3"><label class="form-label">Email admin</label><input class="form-control" type="email" name="email" required autocomplete="username"/></div><div class="mb-3"><label class="form-label">Mật khẩu</label><input class="form-control" type="password" name="password" required minlength="8" autocomplete="current-password"/></div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="rememberMe" id="adminRemember"/><label class="form-check-label" for="adminRemember">Ghi nhớ đăng nhập</label></div><button class="btn btn-dark w-100" type="submit">Đăng nhập admin</button></form><div class="text-center mt-3"><a href="/">Về trang chủ</a></div></div></div>
@code { [SupplyParameterFromQuery] public string? Error { get; set; } }
