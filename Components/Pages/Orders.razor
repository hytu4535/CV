@page "/orders"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "User")]
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using ShopBlazor.Data
@using ShopBlazor.Models
@inject ShopDbContext Db
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState

<PageTitle>Đơn hàng của tôi - MyShop</PageTitle><h3 class="mb-4">Đơn hàng của tôi</h3>@if(!string.IsNullOrEmpty(Message)){<div class="alert alert-danger">@Message</div>}@if(OrderList.Count==0){<div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>}else{<div class="bg-white rounded-3 shadow-sm table-responsive p-3"><table class="table align-middle"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Trạng thái</th><th>Tổng tiền</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var order in OrderList){<tr><td>#@order.Id</td><td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge text-bg-secondary">@order.StatusVietnamese</span></td><td>@order.TotalAmount.ToString("N0") ₫</td><td class="text-end"><a class="btn btn-sm btn-outline-dark me-1" href="/orders/@order.Id">Xem chi tiết</a>@if(order.Status==OrderStatus.Pending){<button class="btn btn-sm btn-outline-danger" @onclick="()=>Cancel(order.Id)">Hủy đơn</button>}</td></tr>}}</tbody></table></div>}
@code {private List<Order> OrderList=new();private string? Message;private int CustomerId;protected override async Task OnInitializedAsync(){var state=await AuthState.GetAuthenticationStateAsync();if(int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier),out CustomerId))OrderList=await LoadOrders();}private Task<List<Order>> LoadOrders()=>Db.Orders.Where(o=>o.CustomerId==CustomerId).OrderByDescending(o=>o.OrderDate).ToListAsync();private async Task Cancel(int id){await using var transaction=await Db.Database.BeginTransactionAsync();var order=await Db.Orders.Include(x=>x.Details!).FirstOrDefaultAsync(x=>x.Id==id&&x.CustomerId==CustomerId);if(order is null)return;if(order.Status!=OrderStatus.Pending){Message="Chỉ có thể hủy đơn khi đơn chưa được nhân viên xác nhận.";return;}foreach(var detail in order.Details??[]){var product=await Db.Products.FindAsync(detail.ProductId);if(product is not null)product.Stock+=detail.Quantity;}order.Status=OrderStatus.Cancelled;await Db.SaveChangesAsync();await transaction.CommitAsync();Message=null;OrderList=await LoadOrders();}}
