@page "/admin/products"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using ShopBlazor.Data
@using ShopBlazor.Models
@inject ShopDbContext Db

<PageTitle>Quản lý sản phẩm - MyShop</PageTitle>
<div class="admin-page-heading"><div><h2>Quản lý sản phẩm</h2><p class="text-muted mb-0">Quản lý thông tin, giá và tồn kho sản phẩm.</p></div><button class="btn btn-dark" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</button></div>
@if(ShowForm){<div class="bg-white rounded-3 shadow-sm p-4 mb-4"><div class="d-flex justify-content-between"><h5>@(EditingId is null ? "Thêm sản phẩm" : "Sửa sản phẩm")</h5><button class="btn-close" @onclick="CloseForm"></button></div><EditForm Model="Form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-6"><label class="form-label">Tên sản phẩm</label><InputText class="form-control" @bind-Value="Form.Name"/><ValidationMessage For="()=>Form.Name"/></div><div class="col-md-6"><label class="form-label">Danh mục</label><InputSelect class="form-select" @bind-Value="Form.CategoryId"><option value="0">-- Chọn danh mục --</option>@foreach(var c in Categories){<option value="@c.Id">@c.Name</option>}</InputSelect><ValidationMessage For="()=>Form.CategoryId"/></div><div class="col-md-4"><label class="form-label">Giá</label><InputNumber class="form-control" @bind-Value="Form.Price"/><ValidationMessage For="()=>Form.Price"/></div><div class="col-md-4"><label class="form-label">Giá cũ</label><InputNumber class="form-control" @bind-Value="Form.OldPrice"/></div><div class="col-md-4"><label class="form-label">Tồn kho</label><InputNumber class="form-control" @bind-Value="Form.Stock"/><ValidationMessage For="()=>Form.Stock"/></div><div class="col-md-6"><label class="form-label">Ảnh URL</label><InputText class="form-control" @bind-Value="Form.ImageUrl"/></div><div class="col-md-6"><label class="form-label">Mô tả</label><InputText class="form-control" @bind-Value="Form.Description"/></div></div>@if(!string.IsNullOrEmpty(Message)){<div class="alert alert-danger mt-3">@Message</div>}<div class="mt-3"><button class="btn btn-dark me-2" type="submit">Lưu</button><button class="btn btn-outline-secondary" type="button" @onclick="CloseForm">Hủy</button></div></EditForm></div>}
<div class="bg-white rounded-3 shadow-sm table-responsive p-3"><table class="table table-hover align-middle mb-0"><thead><tr><th>ID</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var product in Products){<tr><td>#@product.Id</td><td>@product.Name</td><td>@product.Category?.Name</td><td>@product.Price.ToString("N0") ₫</td><td><span class="badge @(product.Stock == 0 ? "text-bg-danger" : "text-bg-secondary")">@product.Stock</span></td><td class="text-end"><button class="btn btn-sm btn-outline-dark me-1" @onclick="()=>OpenEdit(product)"><i class="bi bi-pencil"></i> Sửa</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>Delete(product)"><i class="bi bi-trash"></i></button></td></tr>}</tbody></table></div>
@code {private List<Product> Products=new();private List<Category> Categories=new();private ProductForm Form=new();private bool ShowForm;private int? EditingId;private string? Message;protected override async Task OnInitializedAsync(){Categories=await Db.Categories.OrderBy(x=>x.Name).ToListAsync();await Load();}private async Task Load()=>Products=await Db.Products.Include(x=>x.Category).OrderByDescending(x=>x.Id).ToListAsync();private void OpenCreate(){EditingId=null;Form=new();Message=null;ShowForm=true;}private void OpenEdit(Product product){EditingId=product.Id;Form=new ProductForm{Name=product.Name,CategoryId=product.CategoryId,Price=product.Price,OldPrice=product.OldPrice,Stock=product.Stock,ImageUrl=product.ImageUrl,Description=product.Description};Message=null;ShowForm=true;}private void CloseForm(){ShowForm=false;Message=null;}private async Task Save(){if(!await Db.Categories.AnyAsync(x=>x.Id==Form.CategoryId)){Message="Vui lòng chọn danh mục hợp lệ.";return;}Product product;if(EditingId is null){product=new Product{Name=Form.Name.Trim(),CategoryId=Form.CategoryId,Price=Form.Price,OldPrice=Form.OldPrice,Stock=Form.Stock,ImageUrl=Form.ImageUrl,Description=Form.Description};Db.Products.Add(product);}else{product=await Db.Products.FindAsync(EditingId.Value)??throw new InvalidOperationException();product.Name=Form.Name.Trim();product.CategoryId=Form.CategoryId;product.Price=Form.Price;product.OldPrice=Form.OldPrice;product.Stock=Form.Stock;product.ImageUrl=Form.ImageUrl;product.Description=Form.Description;}await Db.SaveChangesAsync();await Load();CloseForm();}private async Task Delete(Product product){if(await Db.OrderDetails.AnyAsync(x=>x.ProductId==product.Id)){Message="Không thể xóa sản phẩm đã có trong đơn hàng.";return;}Db.Products.Remove(product);await Db.SaveChangesAsync();await Load();}private sealed class ProductForm{[Required(ErrorMessage="Vui lòng nhập tên sản phẩm.")][StringLength(150,ErrorMessage="Tên sản phẩm tối đa 150 ký tự.")]public string Name{get;set;}=string.Empty;[Range(1,int.MaxValue,ErrorMessage="Danh mục không hợp lệ.")]public int CategoryId{get;set;}[Range(1000,1000000000,ErrorMessage="Giá phải từ 1.000 trở lên.")]public decimal Price{get;set;}[Range(0,1000000000,ErrorMessage="Giá cũ không được âm.")]public decimal? OldPrice{get;set;}[Range(0,100000,ErrorMessage="Tồn kho không được âm.")]public int Stock{get;set;}public string? ImageUrl{get;set;}public string? Description{get;set;}}}
