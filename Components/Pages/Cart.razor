@page "/cart"
@using ShopBlazor.Services
@inject CartState CartState
@inject NavigationManager Nav

<PageTitle>Giỏ hàng - MyShop</PageTitle><h3 class="mb-4">Giỏ hàng của bạn</h3>
@if(!CartState.Items.Any()){<div class="bg-white rounded-3 shadow-sm text-center py-5"><i class="bi bi-cart-x display-4 text-muted"></i><h5 class="mt-3">Giỏ hàng đang trống</h5><a href="/products" class="btn btn-dark mt-2">Xem sản phẩm</a></div>}else{<div class="row g-4"><div class="col-lg-8"><div class="bg-white rounded-3 shadow-sm p-3 table-responsive"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var item in CartState.Items){<tr><td><a href="/products/@item.Product.Id">@item.Product.Name</a></td><td>@item.Product.Price.ToString("N0") ₫</td><td><input class="form-control form-control-sm" style="max-width:80px" type="number" min="1" max="@item.Product.Stock" @bind="item.Quantity" /></td><td>@item.Total.ToString("N0") ₫</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>Remove(item.Product.Id)"><i class="bi bi-trash"></i></button></td></tr>}</tbody></table></div></div><div class="col-lg-4"><div class="bg-white rounded-3 shadow-sm p-4"><h5>Tóm tắt đơn hàng</h5><div class="d-flex justify-content-between"><span>Tạm tính</span><span>@CartState.SubTotal.ToString("N0") ₫</span></div><div class="d-flex justify-content-between"><span>Vận chuyển</span><span>@(CartState.Shipping == 0 ? "Miễn phí" : CartState.Shipping.ToString("N0")+" ₫")</span></div><hr/><div class="d-flex justify-content-between fs-5 fw-bold"><span>Tổng cộng</span><span>@CartState.GrandTotal.ToString("N0") ₫</span></div><a href="/checkout" class="btn btn-dark w-100 mt-3">Tiến hành thanh toán</a></div></div></div>}
@code { private void Remove(int id){CartState.Remove(id);} }
