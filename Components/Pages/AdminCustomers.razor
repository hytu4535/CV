@page "/admin/customers"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ShopBlazor.Data
@using ShopBlazor.Models
@inject ShopDbContext Db

<PageTitle>Quản lý tài khoản - MyShop</PageTitle>
<div class="admin-page-heading"><div><h2>Quản lý tài khoản</h2><p class="text-muted mb-0">Quản lý tài khoản người dùng và nhân viên.</p></div><button class="btn btn-dark" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Thêm tài khoản</button></div>
@if (ShowForm)
{
    <div class="bg-white rounded-3 shadow-sm p-4 mb-4"><div class="d-flex justify-content-between"><h5>@(EditingId is null ? "Thêm tài khoản" : "Sửa tài khoản")</h5><button class="btn-close" @onclick="CloseForm"></button></div><EditForm Model="Form" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="row g-3"><div class="col-md-6"><label class="form-label">Họ tên</label><InputText class="form-control" @bind-Value="Form.FullName"/><ValidationMessage For="()=>Form.FullName"/></div><div class="col-md-6"><label class="form-label">Email</label><InputText class="form-control" type="email" @bind-Value="Form.Email"/><ValidationMessage For="()=>Form.Email"/></div><div class="col-md-6"><label class="form-label">Điện thoại</label><InputText class="form-control" @bind-Value="Form.Phone"/><ValidationMessage For="()=>Form.Phone"/></div><div class="col-md-6"><label class="form-label">Vai trò</label><InputSelect class="form-select" @bind-Value="Form.Role"><option value="User">User</option><option value="Staff">Staff</option></InputSelect></div><div class="col-md-6"><label class="form-label">Mật khẩu @(EditingId is not null ? "mới (để trống nếu không đổi)" : "")</label><InputText class="form-control" type="password" @bind-Value="Form.Password"/><ValidationMessage For="()=>Form.Password"/></div><div class="col-md-6"><label class="form-label">Địa chỉ</label><InputText class="form-control" @bind-Value="Form.Address"/></div></div><div class="mt-3"><button class="btn btn-dark me-2" type="submit">Lưu</button><button class="btn btn-outline-secondary" type="button" @onclick="CloseForm">Hủy</button></div>@if(!string.IsNullOrEmpty(Message)){<div class="alert alert-danger mt-3">@Message</div>}</EditForm></div>
}
<div class="bg-white rounded-3 shadow-sm table-responsive p-3"><table class="table table-hover align-middle mb-0"><thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Vai trò</th><th class="text-end">Thao tác</th></tr></thead><tbody>@foreach(var customer in Customers){<tr><td>#@customer.Id</td><td>@customer.FullName</td><td>@customer.Email</td><td>@customer.Phone</td><td><span class="badge @(customer.Role == "Staff" ? "text-bg-primary" : "text-bg-secondary")">@customer.Role</span></td><td class="text-end"><button class="btn btn-sm btn-outline-dark me-1" @onclick="()=>OpenEdit(customer)"><i class="bi bi-pencil"></i> Sửa</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>Delete(customer)"><i class="bi bi-trash"></i></button></td></tr>}</tbody></table></div>
@code {
    private List<Customer> Customers = new(); private CustomerForm Form = new(); private bool ShowForm; private int? EditingId; private string? Message;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => Customers = await Db.Customers.OrderBy(x => x.Id).ToListAsync();
    private void OpenCreate(){EditingId=null;Form=new();Message=null;ShowForm=true;}
    private void OpenEdit(Customer customer){EditingId=customer.Id;Form=new CustomerForm{FullName=customer.FullName,Email=customer.Email,Phone=customer.Phone,Address=customer.Address,Role=customer.Role};Message=null;ShowForm=true;}
    private void CloseForm(){ShowForm=false;Message=null;}
    private async Task Save(){var email=Form.Email.Trim();if(await Db.Customers.AnyAsync(x=>x.Email==email&&x.Id!=EditingId)){Message="Email đã tồn tại.";return;}if(EditingId is null&&string.IsNullOrWhiteSpace(Form.Password)){Message="Vui lòng nhập mật khẩu cho tài khoản mới.";return;}Customer customer;if(EditingId is null){customer=new Customer{FullName=Form.FullName.Trim(),Email=email,Phone=Form.Phone.Trim(),Address=Form.Address,Role=Form.Role};customer.PasswordHash=new PasswordHasher<Customer>().HashPassword(customer,Form.Password!);Db.Customers.Add(customer);}else{customer=await Db.Customers.FindAsync(EditingId.Value)??throw new InvalidOperationException();customer.FullName=Form.FullName.Trim();customer.Email=email;customer.Phone=Form.Phone.Trim();customer.Address=Form.Address;customer.Role=Form.Role;if(!string.IsNullOrWhiteSpace(Form.Password))customer.PasswordHash=new PasswordHasher<Customer>().HashPassword(customer,Form.Password);}await Db.SaveChangesAsync();await Load();CloseForm();}
    private async Task Delete(Customer customer){if(await Db.Orders.AnyAsync(x=>x.CustomerId==customer.Id)){Message="Không thể xóa tài khoản đã có đơn hàng.";return;}Db.Customers.Remove(customer);await Db.SaveChangesAsync();await Load();}
    private sealed class CustomerForm{[Required(ErrorMessage="Vui lòng nhập họ tên.")][RegularExpression(@"^[a-zA-ZÀ-ỹ\s]{2,100}$",ErrorMessage="Họ tên không hợp lệ.")]public string FullName{get;set;}=string.Empty;[Required(ErrorMessage="Vui lòng nhập email.")][EmailAddress(ErrorMessage="Email không đúng định dạng.")]public string Email{get;set;}=string.Empty;[Required(ErrorMessage="Vui lòng nhập số điện thoại.")][RegularExpression(@"^(0|\+84)(3|5|7|8|9)\d{8}$",ErrorMessage="Số điện thoại Việt Nam không hợp lệ.")]public string Phone{get;set;}=string.Empty;[MinLength(8,ErrorMessage="Mật khẩu tối thiểu 8 ký tự.")]public string? Password{get;set;}public string? Address{get;set;}public string Role{get;set;}="User";}
}
