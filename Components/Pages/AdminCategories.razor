@page "/admin/categories"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using ShopBlazor.Data
@using ShopBlazor.Models
@inject ShopDbContext Db

<PageTitle>Quản lý danh mục - MyShop</PageTitle>
<div class="admin-page-heading">
    <div>
        <h2>Quản lý danh mục</h2>
        <p class="text-muted mb-0">Danh mục sản phẩm trong cửa hàng.</p>
    </div>
    <button class="btn btn-dark" @onclick="OpenCreate">
        <i class="bi bi-plus-lg"></i> Thêm danh mục
    </button>
</div>
@if(ShowForm)
{
    <div class="bg-white rounded-3 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between">
            <h5>@(EditingId is null ? "Thêm danh mục" : "Sửa danh mục")</h5>
            <button class="btn-close" @onclick="CloseForm"></button>
        </div>
        <EditForm Model="Form" OnValidSubmit="Save">
            <DataAnnotationsValidator/>
            <ValidationSummary/>
            <label class="form-label">Tên danh mục</label>
            <InputText class="form-control" @bind-Value="Form.Name"/>
            <ValidationMessage For="()=>Form.Name"/>
            @if(!string.IsNullOrEmpty(Message))
            {
                <div class="alert alert-danger mt-3">@Message</div>
            }
            <div class="mt-3">
                <button class="btn btn-dark me-2" type="submit">Lưu</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseForm">Hủy</button>
            </div>
        </EditForm>
    </div>
}
<div class="bg-white rounded-3 shadow-sm table-responsive p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var category in Categories)
            {
                <tr>
                    <td>#@category.Id</td>
                    <td>@category.Name</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-dark me-1" @onclick="()=>OpenEdit(category)">
                            <i class="bi bi-pencil"></i> Sửa
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="()=>Delete(category)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<Category> Categories=new();
    private CategoryForm Form=new();
    private bool ShowForm;
    private int? EditingId;
    private string? Message;

    protected override async Task OnInitializedAsync()=>await Load();

    private async Task Load()=>Categories=await Db.Categories.OrderBy(x=>x.Name).ToListAsync();

    private void OpenCreate()
    {
        EditingId=null;
        Form=new();
        Message=null;
        ShowForm=true;
    }

    private void OpenEdit(Category category)
    {
        EditingId=category.Id;
        Form=new CategoryForm{Name=category.Name};
        Message=null;
        ShowForm=true;
    }

    private void CloseForm()
    {
        ShowForm=false;
        Message=null;
    }

    private async Task Save()
    {
        var name=Form.Name.Trim();
        if(await Db.Categories.AnyAsync(x=>x.Name==name&&x.Id!=EditingId))
        {
            Message="Danh mục đã tồn tại.";
            return;
        }

        if(EditingId is null)
            Db.Categories.Add(new Category{Name=name});
        else
        {
            var category=await Db.Categories.FindAsync(EditingId.Value)??throw new InvalidOperationException();
            category.Name=name;
        }
        await Db.SaveChangesAsync();
        await Load();
        CloseForm();
    }

    private async Task Delete(Category category)
    {
        if(await Db.Products.AnyAsync(x=>x.CategoryId==category.Id))
        {
            Message="Không thể xóa danh mục đang có sản phẩm.";
            return;
        }

        Db.Categories.Remove(category);
        await Db.SaveChangesAsync();
        await Load();
    }

    private sealed class CategoryForm
    {
        [Required(ErrorMessage="Vui lòng nhập tên danh mục.")]
        [StringLength(100,ErrorMessage="Tên danh mục tối đa 100 ký tự.")]
        public string Name{get;set;}=string.Empty;
    }
}
