@page "/admin/orders"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using ShopBlazor.Data
@using ShopBlazor.Models
@inject ShopDbContext Db

<PageTitle>Quản lý đơn hàng - MyShop</PageTitle><h2 class="mb-3">Quản lý đơn hàng</h2>@if(!string.IsNullOrEmpty(Message)){<div class="alert alert-danger">@Message</div>}<div class="bg-white rounded-3 shadow-sm table-responsive p-3"><table class="table align-middle"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var order in Orders){<tr><td>#@order.Id</td><td>@order.Customer?.FullName</td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@order.TotalAmount.ToString("N0") ₫</td><td><select @key="@(order.Id + "-" + StatusRenderVersion)" class="form-select form-select-sm" value="@((int)order.Status)" @onchange="e=>ChangeStatus(order, e)"><option value="0">Chờ xử lý</option><option value="1">Đang giao</option><option value="2">Hoàn thành</option><option value="3">Đã hủy</option></select></td></tr>}</tbody></table></div>
@code { private List<Order> Orders=new();private string? Message;private int StatusRenderVersion;protected override async Task OnInitializedAsync()=>Orders=await Db.Orders.Include(x=>x.Customer).OrderByDescending(x=>x.OrderDate).ToListAsync();private async Task ChangeStatus(Order order,ChangeEventArgs args){Message=null;if(!int.TryParse(args.Value?.ToString(),out var value)){StatusRenderVersion++;return;}var next=(OrderStatus)value;var valid=order.Status switch{OrderStatus.Pending=>next is OrderStatus.Shipping or OrderStatus.Cancelled,OrderStatus.Shipping=>next is OrderStatus.Completed or OrderStatus.Cancelled,_=>false};if(!valid){Message=$"Không thể chuyển từ '{order.StatusVietnamese}' sang '{next switch{OrderStatus.Shipping=>"Đang giao",OrderStatus.Completed=>"Hoàn thành",OrderStatus.Cancelled=>"Đã hủy",_=>"Chờ xử lý"}}'. Chỉ được duyệt đơn theo thứ tự.";StatusRenderVersion++;return;}if(next==OrderStatus.Cancelled){var tracked=await Db.Orders.Include(x=>x.Details!).FirstAsync(x=>x.Id==order.Id);foreach(var detail in tracked.Details??[]){var product=await Db.Products.FindAsync(detail.ProductId);if(product is not null)product.Stock+=detail.Quantity;}tracked.Status=next;}else order.Status=next;await Db.SaveChangesAsync();StatusRenderVersion++;}}
