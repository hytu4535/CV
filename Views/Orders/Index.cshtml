@model IReadOnlyList<ShopMvc.Models.Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<h1>Đơn hàng của tôi</h1>
<table><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var order in Model) { <tr><td>@order.Code</td><td>@order.CreatedAt.ToLocalTime()</td><td>@order.TotalAmount.ToString("N0") đ</td><td>@order.Status</td><td><a asp-action="Detail" asp-route-id="@order.Id">Xem chi tiết</a></td></tr> }
</tbody></table>