@model ShopMvc.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "Hồ sơ"; }<h1>Hồ sơ</h1>@if (TempData["AccountMessage"] is string message) { <div class="notice success">@message</div> }<form asp-area="" asp-controller="Account" asp-action="Profile" method="post" novalidate><div asp-validation-summary="ModelOnly"></div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span><label asp-for="Phone"></label><input asp-for="Phone" /><span asp-validation-for="Phone"></span><button type="submit">Lưu thông tin</button></form><p><a class="button small" asp-area="" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></p>@await Html.PartialAsync("_ValidationScriptsPartial")
