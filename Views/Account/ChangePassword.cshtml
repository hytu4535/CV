@model ShopMvc.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<h1>Đổi mật khẩu</h1>
<form asp-area="" asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly"></div>
    <label asp-for="CurrentPassword"></label><input class="input" asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span>
    <label asp-for="NewPassword"></label><input class="input" asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span>
    <label asp-for="ConfirmPassword"></label><input class="input" asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span>
    <button type="submit">Cập nhật mật khẩu</button>
</form>
