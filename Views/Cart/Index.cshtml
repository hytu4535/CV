@model ShopMvc.ViewModels.CartViewModel
@{ ViewData["Title"] = "Giỏ hàng"; }
<section class="page-heading"><div><p class="eyebrow">ĐƠN HÀNG CỦA BẠN</p><h1>Giỏ hàng</h1></div></section>
@if (TempData["CartMessage"] is string message) { <div class="notice success">@message</div> }
@if (TempData["CartError"] is string error) { <div class="notice error">@error</div> }
@if (Model.Lines.Count == 0)
{
    <section class="empty-state"><h2>Giỏ hàng đang trống</h2><p class="muted">Hãy chọn sản phẩm bạn yêu thích để bắt đầu mua sắm.</p><a class="button" asp-area="" asp-controller="Home" asp-action="Index">Xem sản phẩm</a></section>
}
else
{
    <section class="cart-panel">
        <div class="table-wrap"><table class="cart-table"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>
        @foreach (var line in Model.Lines)
        {
            <tr class="cart-row"><td><a class="cart-name" asp-area="" asp-controller="Home" asp-action="Details" asp-route-slug="@line.Slug">@line.Name</a></td><td><span class="unit-price" data-price="@line.Price">@line.Price.ToString("N0") đ</span></td><td><form class="quantity-form" asp-area="" asp-controller="Cart" asp-action="Update" method="post"><input type="hidden" name="productId" value="@line.ProductId" /><input type="number" name="quantity" value="@line.Quantity" min="1" max="@line.Stock" /><button class="link-button" type="submit">Cập nhật</button></form></td><td><strong class="line-total" data-total="@line.Total">@line.Total.ToString("N0") đ</strong></td><td><form asp-area="" asp-controller="Cart" asp-action="Remove" method="post"><input type="hidden" name="productId" value="@line.ProductId" /><button class="link-button danger-link" type="submit">Xóa</button></form></td></tr>
        }
        </tbody></table></div>
        <div class="cart-total"><span>Tổng cộng</span><strong id="cart-total" data-total="@Model.Total">@Model.Total.ToString("N0") đ</strong></div>
        <a class="button full checkout-button" asp-area="" asp-controller="Cart" asp-action="Checkout">Tiến hành thanh toán</a>
    </section>
}
