@model ShopMvc.Helpers.PagedList<ShopMvc.Models.Product>
@{ ViewData["Title"] = "Giỏ hàng"; }
<section class="hero"><div><p class="eyebrow">BỘ SƯU TẬP MỚI</p><h1>Phụ kiện cho<br /><em>phong cách</em> riêng.</h1><p>Khám phá những sản phẩm được chọn lọc dành cho bạn.</p><a class="button" href="#products">Mua sắm ngay</a></div><div class="hero-shape">SHOP<br />MVC</div></section>
<div class="product-filter"><form asp-area="" asp-controller="Home" asp-action="Index" method="get"><div><label for="search">Tên sản phẩm</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên..." /></div><div><label for="categoryId">Danh mục</label><select id="categoryId" name="categoryId"><option value="">Tất cả danh mục</option>@foreach (var category in ViewBag.Categories) { <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id ? "selected" : null)">@category.Name</option> }</select></div><div><label for="minPrice">Giá từ</label><input id="minPrice" name="minPrice" type="number" min="0" value="@ViewBag.MinPrice" /></div><div><label for="maxPrice">Giá đến</label><input id="maxPrice" name="maxPrice" type="number" min="0" value="@ViewBag.MaxPrice" /></div><div><label for="sort">Sắp xếp</label><select id="sort" name="sort"><option value="name" selected="@(ViewBag.Sort == "name" ? "selected" : null)">Tên A-Z</option><option value="priceAsc" selected="@(ViewBag.Sort == "priceAsc" ? "selected" : null)">Giá tăng dần</option><option value="priceDesc" selected="@(ViewBag.Sort == "priceDesc" ? "selected" : null)">Giá giảm dần</option></select></div><button class="button" type="submit">Lọc sản phẩm</button></form></div>
<div class="page-heading" id="products"><div><p class="eyebrow">GỢI Ý CHO BẠN</p><h2>Sản phẩm nổi bật</h2></div></div>
<div class="product-grid">@foreach (var p in Model) { <article class="product-card"><div class="product-placeholder">@p.Category.Name</div><div class="product-info"><span class="category">@p.Category.Name</span><h3><a asp-area="" asp-controller="Home" asp-action="Details" asp-route-slug="@p.Slug">@p.Name</a></h3><strong>@p.CurrentPrice.ToString("N0") đ</strong><div class="product-actions"><a class="button small" asp-area="" asp-controller="Home" asp-action="Details" asp-route-slug="@p.Slug">Chi tiết</a><form asp-area="" asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@p.Id" /><button class="button small" type="submit">Mua ngay</button></form></div></div></article> }</div>
<div class="pagination">Trang @Model.PageIndex / @Model.TotalPages @if (Model.PageIndex < Model.TotalPages) { <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-sort="@ViewBag.Sort" asp-route-page="@(Model.PageIndex + 1)">Trang sau →</a> }</div>
