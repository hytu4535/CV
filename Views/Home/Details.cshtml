@model ShopMvc.Models.Product
@{ ViewData["Title"] = Model.Name; }<article class="detail-card"><div class="product-placeholder detail-placeholder">@Model.Category.Name</div><div class="detail-info"><p class="eyebrow">@Model.Category.Name</p><h1>@Model.Name</h1><p class="detail-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "Sản phẩm chất lượng dành cho phong cách của bạn." : Model.Description)</p><strong class="detail-price">@Model.CurrentPrice.ToString("N0") đ</strong><p class="muted">Còn lại: @Model.Stock sản phẩm</p>@if (Model.Stock > 0) { <form asp-area="" asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="/cart" /><button class="button full" type="submit">Thêm vào giỏ hàng</button></form> } else { <span class="badge">Hết hàng</span> }</div></article>
