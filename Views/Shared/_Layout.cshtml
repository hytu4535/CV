<!doctype html>
<html lang="vi">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - ShopMvc</title><link rel="stylesheet" href="/css/site.css" /></head>
<body>
<header class="store-header"><div class="container header-inner"><a class="brand" asp-area="" asp-controller="Home" asp-action="Index">SHOPMVC</a><form asp-area="" class="search" asp-controller="Home" asp-action="Index" method="get"><input name="search" placeholder="Tìm kiếm sản phẩm..." /><button type="submit">Tìm</button></form><nav><a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a>@if (User.FindFirst("CustomerId") is not null) { <a asp-area="" asp-controller="Account" asp-action="Profile">Hồ sơ</a><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Đăng xuất</button></form> } else { <a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a><a class="button small" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a> }</nav></div></header>
<main class="container page-container">@RenderBody()</main>
<footer><div class="container">© @DateTime.Now.Year ShopMvc · Cửa hàng phụ kiện thời trang</div></footer><script src="/js/site.js" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
