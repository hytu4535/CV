@model ShopMvc.ViewModels.AdminUserFormViewModel
@{ ViewData["Title"] = "Thêm tài khoản admin"; }
<div class="page-heading"><h1>Thêm tài khoản admin</h1></div>
<form class="admin-form" asp-action="Create" method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span><label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span><label asp-for="RoleId"></label><select asp-for="RoleId" asp-items="ViewBag.Roles"><option value="">-- Chọn vai trò --</option></select><span asp-validation-for="RoleId"></span><label><input asp-for="IsActive" /> Đang hoạt động</label><button class="button" type="submit">Lưu</button></form>
