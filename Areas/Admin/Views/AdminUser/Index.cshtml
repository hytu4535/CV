@model ShopMvc.ViewModels.PagedResultViewModel<ShopMvc.ViewModels.AdminUserListItemViewModel>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="page-heading"><div><p class="eyebrow">IDENTITY</p><h1>Tài khoản</h1><p class="muted">Quản lý người dùng, vai trò và trạng thái truy cập.</p></div><a class="button" asp-action="Create">Thêm tài khoản</a></div>
@if (TempData["Success"] is string message) { <div class="notice success">@message</div> }
<form class="search-form" asp-action="Index" method="get"><input name="search" value="@ViewBag.Search" placeholder="Tìm theo họ tên hoặc email..." /><button class="button" type="submit">Tìm kiếm</button></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.User.FullName</td><td>@item.User.Email</td><td>@string.Join(", ", item.Roles)</td><td>@(item.User.IsActive ? "Đang hoạt động" : "Đã khóa")</td><td><a asp-action="Edit" asp-route-id="@item.User.Id">Sửa</a> <a asp-action="ResetPassword" asp-route-id="@item.User.Id">Đặt lại mật khẩu</a> <form class="inline-form" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.User.Id" /><button class="link-button" type="submit">@(item.User.IsActive ? "Khóa" : "Mở khóa")</button></form> <form class="inline-form" asp-action="Delete" method="post"><input type="hidden" name="id" value="@item.User.Id" /><button class="link-button danger-link" type="submit">Xóa</button></form></td></tr> }</tbody></table></div></section>
@if (Model.TotalPages > 1) { <div class="pagination">@for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++) { <a class="@(currentPage == Model.Page ? "button small" : "")" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@currentPage">@currentPage</a> }</div> }
