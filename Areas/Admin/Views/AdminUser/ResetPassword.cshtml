@model ShopMvc.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<div class="page-heading"><div><p class="eyebrow">IDENTITY</p><h1>Đặt lại mật khẩu</h1></div></div>
<form class="admin-form" asp-action="ResetPassword" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span><button class="button" type="submit">Lưu mật khẩu</button></form>
