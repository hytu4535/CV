@model ShopMvc.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Tổng quan"; }
<div class="page-heading"><div><p class="eyebrow">TỔNG QUAN</p><h1>Dashboard</h1><p class="muted">Tình hình hoạt động mới nhất của cửa hàng.</p></div></div>
<div class="stats-grid"><div class="stat-card"><span>Sản phẩm</span><strong>@Model.ProductCount</strong></div><div class="stat-card"><span>Danh mục</span><strong>@Model.CategoryCount</strong></div><div class="stat-card"><span>Đơn hàng</span><strong>@Model.OrderCount</strong></div><div class="stat-card"><span>Tài khoản</span><strong>@Model.AccountCount</strong></div></div>
<section class="panel"><div class="panel-heading"><h2>Đơn hàng mới nhất</h2><a asp-area="Admin" asp-controller="Orders" asp-action="Index">Xem tất cả</a></div><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var order in Model.LatestOrders) { <tr><td><a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.Id">@order.Code</a></td><td>@order.User.Email</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@order.TotalAmount.ToString("N0") đ</td><td>@order.Status</td></tr> }</tbody></table></div></section>
