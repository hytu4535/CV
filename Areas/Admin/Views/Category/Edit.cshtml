@model ShopMvc.Models.Category
@{ ViewData["Title"] = "Sửa danh mục"; }
<div class="page-heading"><h1>Sửa danh mục</h1></div>
<form class="admin-form" asp-action="Edit" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Name">Tên danh mục</label><input asp-for="Name" placeholder="Nhập tên danh mục" /><span asp-validation-for="Name"></span><label asp-for="Description">Mô tả</label><textarea asp-for="Description" placeholder="Nhập mô tả danh mục"></textarea><span asp-validation-for="Description"></span><label asp-for="DisplayOrder">Thứ tự hiển thị</label><input asp-for="DisplayOrder" type="number" min="0" /><span asp-validation-for="DisplayOrder"></span><label><input asp-for="IsActive" /> Đang hoạt động</label><button class="button" type="submit">Lưu thay đổi</button></form>
