@model ShopMvc.ViewModels.PagedResultViewModel<ShopMvc.Models.Category>
@{ ViewData["Title"] = "Quản lý danh mục"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Danh mục</h1></div><a class="button" asp-action="Create">Thêm danh mục</a></div>
@if (TempData["Success"] is string message) { <div class="notice success">@message</div> }
<form class="search-form" asp-action="Index" method="get"><input name="search" value="@ViewBag.Search" placeholder="Tìm theo tên danh mục..." /><button class="button" type="submit">Tìm kiếm</button></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Name</td><td>@item.Slug</td><td>@item.DisplayOrder</td><td>@(item.IsActive ? "Đang bật" : "Đang tắt")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <form class="inline-form" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button" type="submit">@(item.IsActive ? "Tắt" : "Bật")</button></form> <form class="inline-form" asp-action="Delete" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Xóa</button></form></td></tr> }</tbody></table></div></section>
@if (Model.TotalPages > 1) { <div class="pagination">@for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++) { <a class="@(currentPage == Model.Page ? "button small" : "")" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@currentPage">@currentPage</a> }</div> }
