@model IReadOnlyList<ShopMvc.Models.Category>
@{ ViewData["Title"] = "Quản lý danh mục"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Danh mục</h1></div><a class="button" asp-action="Create">Thêm danh mục</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Where(x => !x.IsDeleted)) { <tr><td>@item.Name</td><td>@item.Slug</td><td>@item.DisplayOrder</td><td>@(item.IsActive ? "Đang bật" : "Đang tắt")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <form class="inline-form" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button" type="submit">@(item.IsActive ? "Tắt" : "Bật")</button></form> <form class="inline-form" asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn ẩn danh mục này không?');"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Ẩn</button></form></td></tr> }</tbody></table></div></section>
