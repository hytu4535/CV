@model ShopMvc.ViewModels.LoginViewModel
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Đăng nhập quản trị</title><link rel="stylesheet" href="/css/site.css" /></head><body class="login-page"><div class="login-card"><div class="brand">SHOPMVC <small>ADMIN</small></div><h1>Đăng nhập quản trị</h1><p class="muted">Sử dụng tài khoản quản trị để tiếp tục</p><form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" novalidate><div class="validation-summary" asp-validation-summary="ModelOnly"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="Email"></label><input class="input" asp-for="Email" autocomplete="username" /><span class="field-error" asp-validation-for="Email"></span><label asp-for="Password"></label><input class="input" asp-for="Password" autocomplete="current-password" /><span class="field-error" asp-validation-for="Password"></span><button class="button full" type="submit">Đăng nhập</button></form><a class="back-link" href="/">← Về cửa hàng</a></div></body></html>
