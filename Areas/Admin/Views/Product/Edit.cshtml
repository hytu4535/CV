@model ShopMvc.ViewModels.AdminProductFormViewModel
@{ ViewData["Title"] = "Sửa sản phẩm"; }
<div class="page-heading"><h1>Sửa sản phẩm</h1></div>
<form class="admin-form" asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name"></span><label asp-for="Price"></label><input asp-for="Price" type="number" min="1000" step="1" /><span asp-validation-for="Price"></span><label asp-for="CategoryId"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories"></select><span asp-validation-for="CategoryId"></span><label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" max="100000" /><span asp-validation-for="Stock"></span><label asp-for="Description"></label><textarea asp-for="Description"></textarea><span asp-validation-for="Description"></span><button class="button" type="submit">Lưu thay đổi</button></form>
