@model ShopMvc.ViewModels.PagedResultViewModel<ShopMvc.Models.Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Sản phẩm</h1></div><a class="button" asp-action="Create">Thêm sản phẩm</a></div>
@if (TempData["Success"] is string message) { <div class="notice success">@message</div> }
<form class="search-form" asp-action="Index" method="get"><input name="search" value="@ViewBag.Search" placeholder="Tìm theo tên hoặc SKU..." /><button class="button" type="submit">Tìm kiếm</button></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Sku</td><td>@item.Name</td><td>@item.Category.Name</td><td>@item.CurrentPrice.ToString("N0") đ</td><td>@item.Stock</td><td>@(item.IsActive ? "Đang bán" : "Đang ẩn")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <form class="inline-form" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button" type="submit">@(item.IsActive ? "Ẩn" : "Bật")</button></form> <form class="inline-form" asp-action="Delete" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Xóa</button></form></td></tr> }</tbody></table></div></section>
@if (Model.TotalPages > 1) { <div class="pagination">@for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++) { <a class="@(currentPage == Model.Page ? "button small" : "")" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@currentPage">@currentPage</a> }</div> }
