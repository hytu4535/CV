@model IReadOnlyList<ShopMvc.Models.Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Sản phẩm</h1></div><a class="button" asp-action="Create">Thêm sản phẩm</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Sku</td><td>@item.Name</td><td>@item.Category.Name</td><td>@item.CurrentPrice.ToString("N0") đ</td><td>@item.Stock</td><td>@(item.IsActive ? "Đang bán" : "Đang ẩn")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <form class="inline-form" asp-action="Toggle" method="post" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái hiển thị sản phẩm này không?');"><input type="hidden" name="id" value="@item.Id" /><button class="link-button" type="submit">@(item.IsActive ? "Ẩn" : "Bật")</button></form> <form class="inline-form" asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn ẩn sản phẩm này không?');"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Ẩn</button></form></td></tr> }</tbody></table></div></section>
