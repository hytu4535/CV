@model IReadOnlyList<Microsoft.AspNetCore.Identity.IdentityRole>
@{ ViewData["Title"] = "Phân quyền"; }
<div class="page-heading"><div><p class="eyebrow">BẢO MẬT</p><h1>Vai trò và quyền</h1></div><a class="button" asp-action="Create">Thêm vai trò</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>@if (item.Name != "Admin") { <form class="inline-form" asp-action="Delete" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Xóa</button></form> }</td></tr> }</tbody></table></div></section>
