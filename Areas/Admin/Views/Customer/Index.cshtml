@model IReadOnlyList<ShopMvc.Models.Customer>
@{ ViewData["Title"] = "Quản lý khách hàng"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN LÝ</p><h1>Khách hàng</h1></div><a class="button" asp-action="Create">Thêm khách hàng</a></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Họ tên</th><th>Email</th><th>Số điện thoại</th><th>Địa chỉ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.FullName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.Address</td><td>@(item.IsActive ? "Đang hoạt động" : "Đã khóa")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> <form class="inline-form" asp-action="Toggle" method="post" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái khóa của khách hàng này không?');"><input type="hidden" name="id" value="@item.Id" /><button class="link-button" type="submit">@(item.IsActive ? "Khóa" : "Mở khóa")</button></form> <form class="inline-form" asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn khóa khách hàng này không? Dữ liệu lịch sử sẽ được giữ lại.');"><input type="hidden" name="id" value="@item.Id" /><button class="link-button danger-link" type="submit">Khóa</button></form></td></tr> }</tbody></table></div></section>
