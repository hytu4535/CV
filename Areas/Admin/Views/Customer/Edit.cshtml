@model ShopMvc.ViewModels.AdminCustomerFormViewModel
@{ ViewData["Title"] = "Sửa khách hàng"; }
<div class="page-heading"><h1>Sửa khách hàng</h1></div>
<form class="admin-form" asp-action="Edit" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName"></span><label asp-for="Email">Email đăng nhập (không thể thay đổi)</label><input asp-for="Email" readonly /><span asp-validation-for="Email"></span><label asp-for="Phone"></label><input asp-for="Phone" /><span asp-validation-for="Phone"></span><label asp-for="Address"></label><input asp-for="Address" /><span asp-validation-for="Address"></span><label asp-for="Password">Mật khẩu mới (không bắt buộc)</label><input asp-for="Password" /><span asp-validation-for="Password"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span><label><input asp-for="IsActive" /> Đang hoạt động</label><button class="button" type="submit">Lưu thay đổi</button></form>
