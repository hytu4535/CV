<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản trị ShopMvc</title>
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
    <aside class="admin-sidebar">
        <a class="brand" href="/admin">SHOPMVC <small>ADMIN</small></a>
        <nav>
            @if (await Context.HasPermissionAsync(Permissions.DashboardView)) { <a href="/admin">Tổng quan</a> }
            @if (await Context.HasPermissionAsync(Permissions.ProductView)) { <a asp-area="Admin" asp-controller="Product" asp-action="Index">Sản phẩm</a> }
            @if (await Context.HasPermissionAsync(Permissions.CategoryView)) { <a asp-area="Admin" asp-controller="Category" asp-action="Index">Danh mục</a> }
            @if (await Context.HasPermissionAsync(Permissions.UserView)) { <a asp-area="Admin" asp-controller="AdminUser" asp-action="Index">Tài khoản</a> }
            @if (await Context.HasPermissionAsync(Permissions.RoleView)) { <a asp-area="Admin" asp-controller="Role" asp-action="Index">Vai trò & quyền</a> }
            @if (await Context.HasPermissionAsync(Permissions.OrderView)) { <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Đơn hàng</a> }
            <a href="/">Xem cửa hàng</a>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Đăng xuất</button></form>
        </nav>
    </aside>
    <section class="admin-content">
        <header class="admin-header"><span>Trang quản trị</span><strong>@User.Identity?.Name</strong></header>
        <main class="page-container">@RenderBody()</main>
    </section>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
