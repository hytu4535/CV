@model ShopMvc.Models.Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; string StatusText(ShopMvc.Models.OrderStatus status) => status switch { ShopMvc.Models.OrderStatus.Pending => "Chờ xử lý", ShopMvc.Models.OrderStatus.Shipping => "Đang giao", ShopMvc.Models.OrderStatus.Completed => "Hoàn thành", ShopMvc.Models.OrderStatus.Cancelled => "Đã hủy", _ => "Không xác định" }; }
<div class="page-heading"><div><p class="eyebrow">CHI TIẾT ĐƠN HÀNG</p><h1>@Model.Code</h1><p class="muted">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><a class="button" asp-area="Admin" asp-controller="Orders" asp-action="Index">Quay lại</a></div>
@if (TempData["Success"] is string message) { <div class="notice success">@message</div> }
<section class="detail-card"><div><p class="eyebrow">TRẠNG THÁI</p><h2>@StatusText(Model.Status)</h2><p class="muted">Cập nhật: @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><div class="detail-info"><h2>Khách hàng</h2><p><strong>Email:</strong> @Model.User.Email</p><p><strong>Người nhận:</strong> @Model.ReceiverName</p><p><strong>Số điện thoại:</strong> @Model.Phone</p><p><strong>Địa chỉ:</strong> @Model.Address</p><p><strong>Thanh toán:</strong> @Model.PaymentMethod</p>@if (!string.IsNullOrWhiteSpace(Model.Note)) { <p><strong>Ghi chú:</strong> @Model.Note</p> }</div></section>
<section class="cart-panel"><div class="panel-heading"><h2>Sản phẩm</h2></div>@foreach (var item in Model.Items) { <div class="cart-line"><div><strong class="cart-name">@item.ProductName</strong><span class="muted">@item.Quantity x @item.UnitPrice.ToString("N0") đ</span></div><span>@((item.Quantity * item.UnitPrice).ToString("N0")) đ</span></div> }<div class="cart-total"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0") đ</strong></div>@if (Model.Status == ShopMvc.Models.OrderStatus.Pending) { <div class="product-actions"><form asp-area="Admin" asp-controller="Orders" asp-action="Status" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="Shipping" /><button class="button" type="submit">Chuyển sang đang giao</button></form><form asp-area="Admin" asp-controller="Orders" asp-action="Status" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="Cancelled" /><button class="button danger-button" type="submit">Hủy đơn và hoàn tồn</button></form></div>} else if (Model.Status == ShopMvc.Models.OrderStatus.Shipping) { <form asp-area="Admin" asp-controller="Orders" asp-action="Status" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="Completed" /><button class="button" type="submit">Đánh dấu hoàn thành</button></form> } else { <p class="muted">Đơn hàng đã kết thúc, không còn thao tác.</p> }</section>
